SAGE_DATABASE_URL=postgresql+psycopg://sage:sage@localhost:5432/sage
SAGE_ALLOWED_ORIGINS=["http://localhost:5173"]
SAGE_STORAGE_ROOT=/data/sage-archive
SAGE_UPLOAD_SSH_HOST=192.168.1.213
SAGE_UPLOAD_SSH_PORT=22
SAGE_UPLOAD_DESTINATION_ROOT=/home/zhengyu/SageDataManager/sample-archive
# Required for first-run setup and signed browser sessions. Use a long random value.
SAGE_AUTH_SESSION_SECRET=
# Account registration and recovery links remain valid for 7 days (seconds).
SAGE_ACCOUNT_INVITATION_TTL_SECONDS=604800
# Legacy upgrade only: existing shared-password accounts migrate on successful login.
SAGE_FIXED_ACCOUNT_PASSWORD=
# Short lifetime for browser download/preview links (seconds).
SAGE_FILE_ACCESS_TTL_SECONDS=120
# Upload commands remain finalizable for 24 hours.
SAGE_UPLOAD_TICKET_TTL_SECONDS=86400
# Maximum size of one file uploaded through the Agent API (bytes).
SAGE_AGENT_UPLOAD_MAX_BYTES=500000000
# Optional Python package mirror used while building the backend image.
SAGE_PYPI_INDEX_URL=https://pypi.org/simple
SAGE_PYPI_TIMEOUT=120
SAGE_PYPI_RETRIES=3
POSTGRES_DB=sage
POSTGRES_USER=sage
POSTGRES_PASSWORD=sage
